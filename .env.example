# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys. This .env.example IS committed
# so future projects know which variables to set.

# --- Supabase ----------------------------------------------------------------
# Find these in your Supabase project: Settings → API
# Safe to expose to the browser (the anon key is protected by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never expose to the browser.
# Bypasses Row Level Security — use only in server code / route handlers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL=http://localhost:3000
